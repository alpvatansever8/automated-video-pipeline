# Copy this file to .env and fill in your own keys. Never commit .env.

# Pexels API key - https://www.pexels.com/api/ (free)
PEXELS_API_KEY=

# Pixabay API key - https://pixabay.com/api/docs/ (free)
PIXABAY_API_KEY=

# ElevenLabs API key - https://elevenlabs.io (Profile > API Keys)
ELEVENLABS_API_KEY=

# Optional: Google AI Studio key for Gemini - https://aistudio.google.com
# Only needed if you do not run a local Ollama server.
GEMINI_API_KEY=
